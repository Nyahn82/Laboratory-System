# Copy this file to .env by running: npm run setup
# Never commit the generated .env file.
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:8080
NATIVE_PUBLIC_BASE_URL=http://localhost:5173

# Generated by scripts/setup-env.mjs
AUTH_JWT_SECRET=replace-with-random-jwt-secret
INTERNAL_SERVICE_TOKEN=replace-with-random-service-token
STORAGE_MASTER_KEY_BASE64=replace-with-32-random-bytes-as-base64
QR_TOKEN_SECRET=replace-with-random-qr-secret
DEV_SEED_PASSWORD=replace-with-a-unique-development-password

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
EXPOSE_DEV_RESET_TOKEN=false

# Native Windows mode. These adapters are explicitly simulated and are shown as such in /ready.
DB_DRIVER=file
OBJECT_STORE_DRIVER=filesystem
LEDGER_DRIVER=file
DATA_ROOT=./data

# Docker/MySQL settings. Docker Compose overrides per-service host/database values.
MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password
MYSQL_APP_PASSWORD=replace-with-a-random-application-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=labchain
MYSQL_PASSWORD=replace-with-a-random-application-password
MYSQL_DATABASE=auth_db

AUTH_PORT=3001
RECORDS_PORT=3002
STORAGE_PORT=3003
VERIFICATION_PORT=3004
AUTH_SERVICE_URL=http://127.0.0.1:3001
RECORDS_SERVICE_URL=http://127.0.0.1:3002
STORAGE_SERVICE_URL=http://127.0.0.1:3003
VERIFICATION_SERVICE_URL=http://127.0.0.1:3004

IPFS_API_URL=http://ipfs:5001
IPFS_GATEWAY_URL=http://ipfs:8080

# Fabric is disabled in the base profile. See docs/BLOCKCHAIN.md.
FABRIC_CHANNEL=labrecords
FABRIC_CHAINCODE=labrecord-contract
FABRIC_MSP_ID=RHULabMSP
FABRIC_GATEWAY_PEER=peer0.rhu.local:7051
FABRIC_TLS_CERT_PATH=/fabric/peer-tls/ca.crt
FABRIC_IDENTITY_CERT_PATH=/fabric/user/signcert.pem
FABRIC_IDENTITY_KEY_PATH=/fabric/user/keystore/key.pem
