{
  "name": "@rhu-labchain/verification-service",
  "version": "0.1.0",
  "private": true,
  "description": "Opaque ledger registration and redacted public QR verification service",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "build": "node --check src/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rhu-labchain/service-kit": "0.1.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "mysql2": "^3.14.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@hyperledger/fabric-gateway": "^1.7.1"
  },
  "devDependencies": {
    "supertest": "^7.1.0",
    "vitest": "^3.1.1"
  }
}
