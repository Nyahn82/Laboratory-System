NODE_ENV=development
PORT=3001
DB_DRIVER=file
DATA_ROOT=../../data
# AUTH_DATA_FILE=../../data/auth/auth.json
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=lab-record-auth
JWT_AUDIENCE=lab-record-platform
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_SECONDS=3600
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
EXPOSE_DEV_RESET_TOKEN=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=auth_db
MYSQL_USER=labchain_auth
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10
DEV_SEED_PASSWORD=
DEV_SEED_EMAIL_DOMAIN=lab.local
